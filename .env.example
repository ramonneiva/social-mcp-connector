# ─────────────────────────────────────────────────────────────────────────────
# social-mcp-connector environment variables
# Copy this file to `.env.local` for local dev, or set these in the Vercel
# project dashboard (Settings → Environment Variables) for deployment.
# NEVER commit real values. `.env*` is git-ignored (except this example).
# ─────────────────────────────────────────────────────────────────────────────

# ── Meta (Facebook + Instagram) ─────────────────────────────────────────────
# Long-lived user/page access token with the permissions listed in the README.
META_ACCESS_TOKEN=
# Instagram Business/Creator account id (NOT the @handle). Numeric id.
META_IG_USER_ID=
# Facebook Page id linked to the Instagram account. Numeric id.
META_PAGE_ID=
# Optional — only used by token-debugging helpers / appsecret_proof.
META_APP_ID=
META_APP_SECRET=

# ── TikTok (Display API) ────────────────────────────────────────────────────
# User access token obtained via TikTok Login Kit OAuth (scopes: user.info.basic,
# user.info.profile, user.info.stats, video.list).
TIKTOK_ACCESS_TOKEN=
# App credentials from the TikTok developer portal. Used by the built-in OAuth
# helper (/api/tiktok/auth → /api/tiktok/callback) to mint TIKTOK_ACCESS_TOKEN.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional — override the OAuth redirect URI. If unset it is derived from the
# request origin as `${origin}/api/tiktok/callback`. Must EXACTLY match the URI
# registered in your TikTok app, e.g.
# https://social-mcp-connector.vercel.app/api/tiktok/callback
TIKTOK_REDIRECT_URI=

# ── MCP endpoint auth (optional) ────────────────────────────────────────────
# If set, every request to the MCP endpoint must send `Authorization: Bearer <value>`.
# If left unset, the endpoint is open (anyone with the URL can call the tools).
MCP_AUTH_TOKEN=

# ── SSE resumability (optional) ─────────────────────────────────────────────
# Only needed if you want resumable SSE streams across serverless invocations.
# Leave unset to deploy without Redis — Streamable HTTP (/api/mcp) works without it.
REDIS_URL=
